# 本地开发复制为 .env
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
APP_BASE_URL=http://localhost:3000/feishu-app
SESSION_SECRET=replace-with-a-long-random-string
PORT=3000
DATABASE_PATH=.data/db.sqlite

